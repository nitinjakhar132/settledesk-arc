# SQLite needs a persistent disk. Defaults to ./data/settledesk.db.
# SETTLEDESK_DB=/persistent-disk/settledesk.db
# Set the exact public origin when deploying behind a reverse proxy.
# APP_ORIGIN=https://your-settledesk.example
# Make newly created merchant workspaces use Arc mainnet by default.
# SETTLEDESK_DEFAULT_NETWORK=mainnet
# Optional dedicated server RPCs. Public RPCs are the default.
# ARC_MAINNET_RPC=https://rpc.mainnet.arc.io
# ARC_TESTNET_RPC=https://rpc.testnet.arc.io
# BASE_MAINNET_RPC=https://mainnet.base.org
# BASE_TESTNET_RPC=https://sepolia.base.org

# Create an app at https://dashboard.privy.io and enable Wallet, Email, and SMS.
NEXT_PUBLIC_PRIVY_APP_ID=your-privy-app-id
# Optional for apps configured to use a public client ID.
# NEXT_PUBLIC_PRIVY_CLIENT_ID=your-privy-client-id

# Optional Relay API key for higher quote/status rate limits. It stays on the
# server; the browser talks through the app's restricted Relay proxy.
# RELAY_API_KEY=your-relay-api-key

# Optional Arc Counter fiat checkout. Card also enables eligible Apple Pay and
# Google Pay wallets in Stripe-hosted Checkout; Cash App Pay is shown separately.
# The Collect tax toggle uses Stripe Tax and requires its business address,
# default product tax code, and registrations to be configured in Stripe.
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...

# Optional PayPal and Venmo checkout. Use sandbox while developing.
# PAYPAL_CLIENT_ID=your-paypal-client-id
# PAYPAL_CLIENT_SECRET=your-paypal-client-secret
# PAYPAL_ENV=sandbox
